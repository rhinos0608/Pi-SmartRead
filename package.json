{
  "name": "pi-read-many",
  "version": "0.1.0",
  "description": "Code intelligence extension for Pi — multi-file reading, intent-based retrieval, repo mapping, symbol search, cross-file resolution, and call graph analysis",
  "author": "Gurpartap Singh",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinos0608/Pi-SmartRead.git"
  },
  "bugs": {
    "url": "https://github.com/rhinos0608/Pi-SmartRead/issues"
  },
  "homepage": "https://github.com/rhinos0608/Pi-SmartRead",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "read_multiple_files",
    "read-many",
    "file-reading",
    "context-packing",
    "repo-map",
    "symbol-search",
    "call-graph",
    "intent-read",
    "tree-sitter",
    "bm25",
    "embeddings",
    "code-intelligence",
    "page-rank"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": ["*.ts", "*.d.ts", "queries/**", "README.md", "LICENSE", "package.json"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp-server": "node --import tsx mcp-server.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.13",
    "ignore": "^7.0.5",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.21.0",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "0.23.2",
    "xxhash-wasm": "^1.1.0",
    "@orama/orama": "^3.1.18",
    "sqlite-vec": "^0.1.9"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^11.7.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4",
    "@types/better-sqlite3": "^7.6.12"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
